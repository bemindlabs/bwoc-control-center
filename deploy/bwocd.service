# systemd --user unit for bwocd on a Linux host (busaba/bemind).
# Install: see deploy/README.md — copy to ~/.config/systemd/user/,
# then `systemctl --user enable --now bwocd`.
[Unit]
Description=BWOC control daemon (signed read API, tailnet-only)
After=network.target

[Service]
ExecStart=%h/.local/bin/bwocd --workspace %h/workspaces/bwoc --bind 127.0.0.1:10130
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
