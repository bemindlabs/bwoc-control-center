<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Persistent OTA host: a loopback static server for the iOS install bundle.
     `tailscale serve` (https port 10131 → http://127.0.0.1:18131) (persisted in
     tailscaled state) exposes it on the tailnet over HTTPS.
     Install: see the iOS OTA section of the top-level README.md — fill
     __HOME__, stage the bundle into __HOME__/.local/share/bwoc-ota, then
     `launchctl load`. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tech.bemind.bwoc-ota</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>http.server</string>
        <string>18131</string>
        <string>--bind</string>
        <string>127.0.0.1</string>
        <string>--directory</string>
        <string>__HOME__/.local/share/bwoc-ota</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/bwoc-ota.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/bwoc-ota.log</string>
</dict>
</plist>
